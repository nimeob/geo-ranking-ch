#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TOKEN="$($SCRIPT_DIR/gh_app_token.sh)"

REMOTE_URL="$(git remote get-url origin)"
if [[ "$REMOTE_URL" =~ ^https:// ]]; then
  remote_without_scheme="${REMOTE_URL#https://}"
  if [[ "$remote_without_scheme" == *@* ]]; then
    remote_host_and_path="${remote_without_scheme#*@}"
  else
    remote_host_and_path="$remote_without_scheme"
  fi
  AUTH_URL="https://x-access-token:${TOKEN}@${remote_host_and_path}"
else
  echo "origin is not HTTPS ($REMOTE_URL). Please switch origin to https for app-token push." >&2
  exit 1
fi

BRANCH="$(git rev-parse --abbrev-ref HEAD)"

set_upstream=0

# Remove a single literal "origin" argument for compatibility and
# swallow git-push upstream flags to avoid persisting tokenized URLs
# into branch.<name>.remote/merge config.
args=()
removed_origin=0
for a in "$@"; do
  case "$a" in
    -u|--set-upstream)
      set_upstream=1
      continue
      ;;
  esac

  if [[ $removed_origin -eq 0 && "$a" == "origin" ]]; then
    removed_origin=1
    continue
  fi

  args+=("$a")
done

if [[ "${#args[@]}" -eq 0 ]]; then
  args=("$BRANCH")
fi

git push "$AUTH_URL" "${args[@]}"

if [[ "$set_upstream" -eq 1 ]]; then
  last_arg_index=$(( ${#args[@]} - 1 ))
  remote_ref="${args[$last_arg_index]}"

  if [[ "$remote_ref" == -* || -z "$remote_ref" ]]; then
    remote_ref="$BRANCH"
  fi

  if [[ "$remote_ref" == *:* ]]; then
    remote_ref="${remote_ref#*:}"
  fi

  remote_ref="${remote_ref#refs/heads/}"
  remote_ref="${remote_ref#origin/}"

  if [[ -z "$remote_ref" ]]; then
    remote_ref="$BRANCH"
  fi

  git fetch origin "$remote_ref:refs/remotes/origin/$remote_ref" >/dev/null
  git branch --set-upstream-to="origin/$remote_ref" "$BRANCH" >/dev/null
fi
