#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

declare -a args
args=("$@")

# `gh auth status` exits non-zero when stale hosts.yml entries exist, even if GH_TOKEN
# auth is healthy. In our GH App token flow we care about the active GH_TOKEN account.
if [[ ${#args[@]} -ge 2 && "${args[0]}" == "auth" && "${args[1]}" == "status" ]]; then
  has_active_flag=false
  for arg in "${args[@]}"; do
    if [[ "$arg" == "--active" ]]; then
      has_active_flag=true
      break
    fi
  done
  if [[ "$has_active_flag" == false ]]; then
    args+=("--active")
  fi
fi

# `gh auth refresh` rejects execution when GH_TOKEN is set in the environment.
# Forward refresh commands with GH_TOKEN unset so routine credential maintenance
# from TOOLS.md works with this wrapper.
if [[ ${#args[@]} -ge 2 && "${args[0]}" == "auth" && "${args[1]}" == "refresh" ]]; then
  exec env -u GH_TOKEN gh "${args[@]}"
fi

GH_TOKEN="$($SCRIPT_DIR/gh_app_token.sh)" exec gh "${args[@]}"
